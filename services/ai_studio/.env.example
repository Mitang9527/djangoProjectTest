# AI 创作工作室独立服务环境变量样例
# 复制为 .env 后按实际值修改

# Django
DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-random-string

# 数据库（docker-compose 内 postgres 服务）
POSTGRES_DB=ai_studio
POSTGRES_USER=ai_studio
POSTGRES_PASSWORD=ai_studio_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 必须与主平台【完全一致】—— 这样本服务才能验签主平台签发的 JWT
JWT_SIGNING_KEY=shared-secret-with-main-platform

# 前端跨域来源（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8123

# 1=同步 mock 生成（接口内直接产出结果）；0=交 Celery worker 异步执行
AI_STUDIO_SYNC=1

# 注册（首次访问）赠送额度
AI_STUDIO_SIGNUP_GIFT=50
