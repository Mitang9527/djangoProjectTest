# ================================================================
# 通知服务（services/notice_service）环境变量示例
# 用途：通知服务运行配置模板，复制为同目录 .env 后填写真实值使用；
#       对应 docker-compose.stack.yml 中的 notice_* 服务。
# 关键：JWT_SIGNING_KEY 应与主平台一致（本服务若需验签主平台 JWT）。
# ================================================================
# 通知服务环境变量示例（与 docker-compose.stack.yml 中的 notice_* 服务对应）
DJANGO_SECRET_KEY=change-me-notice
DEBUG=0
CELERY_BROKER_URL=amqp://rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://
JWT_SIGNING_KEY=ai-studio-mq-shared-secret-2026-prod

# 通知渠道配置（按需填写，留空则对应渠道返回「未配置」错误）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
FEISHU_WEBHOOK=
FEISHU_SECRET=
WECHAT_WEBHOOK=
EMAIL_SEND_USER=
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_STAMP_KEY=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_SEND_LIST=
EMAIL_SENDER_NAME=Admin

# 可选：HTTP 入队接口令牌（设置后 /api/notice/notify/ 需要 X-Notice-Token 头）
# NOTICE_API_TOKEN=
