# ================================================================
# 本地开发 / 生产环境变量配置模板（开发 + 生产）
# 本文是根目录 .env 的【唯一来源模板】；Docker 部署另见 .env.docker，
# 全栈共享变量另见 .env.stack。三者分工见各自文件头注释。
# ================================================================
# 使用说明：
# 1. 复制此文件为 .env:  cp .env.template .env
# 2. 根据环境修改配置：
#    - 开发环境：保持 DEBUG=True, SQLite, REDIS_ENABLED=False 即可
#    - 生产环境：参考下方注释块，启用 PostgreSQL + Redis + SSL
# 3. .env 文件不会被 git 提交（已在 .gitignore 中）
# ================================================================
# 【生产环境快速切换清单】
#   DEBUG=False
#   ENV=PROD
#   SECRET_KEY=<生成 50+ 字符随机串>
#   ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
#   DB_ENGINE=django.db.backends.postgresql  (取消注释)
#   REDIS_ENABLED=True
#   SECURE_SSL_REDIRECT=True
#   GUNICORN_WORKERS=4  (Docker / 生产部署时)
# ================================================================

# ================================================================
# Django 核心配置
# ================================================================

# 调试模式（生产环境必须设为 False）
DEBUG=True

# 密钥（生产环境必须修改！可用 python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())" 生成）
SECRET_KEY=dev-secret-key-change-in-production-!!!

# JWT 签名密钥（建议与 SECRET_KEY 不同）
JWT_SIGNING_KEY=dev-jwt-signing-key-change-in-production-!!!

# API 签名密钥（用于服务间 API 调用认证）
API_SECRET_KEY=dev-api-secret-key-change-in-production-!!!

# 演示登录开关（默认 False；关闭时 DemoLoginView 直接返回 403）
# 本地联调 / 前端自测设 True 可免真实账号签发 JWT；【生产环境必须为 False】
ALLOW_DEMO_LOGIN=False

# 允许的主机名（生产环境必须配置实际域名）
ALLOWED_HOSTS=localhost,127.0.0.1

# 跨域来源（生产环境必须配置实际域名）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Access Token 有效期（小时）
TOKEN_EXPIRE_HOURS=1

# Refresh Token 有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=1

# 滑动会话（Sliding Session）：access token 临近过期时自动续期（需前端配合读取 X-Access-Token 响应头）
# 是否启用滑动续期
SLIDING_SESSION_ENABLED=False
# 触发续期的剩余有效期阈值（秒），默认 300（5 分钟）
SLIDING_REFRESH_THRESHOLD_SECONDS=300

# 会话空闲超时（秒）：已登录用户超过该时长无任何操作则强制登出；0 表示禁用（默认 1800 = 30 分钟）
SESSION_IDLE_TIMEOUT_SECONDS=1800

# 空闲超时排除路径前缀（逗号分隔）：这些路径不参与空闲计时，避免误踢或干扰探活。
# 默认值已覆盖健康检查/静态/媒体/登录页/SSO，通常无需修改；如需追加自定义路径可在此覆盖。
SESSION_IDLE_TIMEOUT_EXEMPT_PATHS=/api/health,/static,/media,/admin/login,/api/users/login,/api/users/oidc,/favicon.ico

# 页面请求空闲超时后的重定向地址（API 请求始终返回 401，不受此影响）
SESSION_IDLE_TIMEOUT_REDIRECT_URL=/admin/login/

# ================================================================
# OIDC 单点登录（SSO）配置
# 设为 True 并填写下方 IdP 信息后，系统启用「使用企业账号登录」
# 可对接任意支持 OpenID Connect 的 IdP（Keycloak / Auth0 / Azure AD / 企业微信 / 飞书 等）
# ================================================================
OIDC_ENABLED=False
# 前端 SPA 地址（OIDC 回调后把 JWT 通过 ?access=...&refresh=... 重定向到此）
OIDC_FRONTEND_REDIRECT_URL=http://localhost:5173/sso-callback
# IdP 注册的客户端 ID / Secret
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
# IdP 各端点（从 IdP 的 .well-known/openid-configuration 获取）
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=
# 可选：IdP 全局登出端点（填写后「登出」会跳转 IdP 统一登出）
OIDC_OP_LOGOUT_ENDPOINT=
# 签名算法（IdP 使用 RS256 公钥签名时填 RS256，对称密钥用 HS256）
OIDC_RP_SIGN_ALGO=RS256
# 是否允许 IdP 首次登录时自动创建本地账号（False 则仅允许已绑定账号登录）
OIDC_CREATE_USER=True
# 用于定位用户唯一标识的 claim 名（默认 email；无 email 的 IdP 可改为 sub）
OIDC_USERNAME_CLAIM=email
# 登出后跳回地址
OIDC_LOGOUT_REDIRECT_URL=/

# 环境类型：DEV 或 PROD
ENV=DEV

# ================================================================
# 项目基础信息
# ================================================================

PROJECT_NAME=DjangoProjectTest
TESTER_NAME=Admin

# ================================================================
# 数据库配置
# ================================================================

# SQLite（开发环境默认）
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# PostgreSQL（推荐生产环境）
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=your_db_name
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost          # Docker 部署时设为 postgres
# DB_PORT=5432

# MySQL
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=your_db_name
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=3306

# 读写分离副本库（可选）：配置其一后自动注入 replica 库 + PrimaryReplicaRouter，
# 读走副本、写走主库；两者都不配则保持单库，零风险。仅 PostgreSQL / MySQL 适用。
# DB_REPLICA_URL=postgresql://user:pass@replica-host:5432/dbname
# DB_REPLICA_DSN=host=replica-host port=5432 dbname=dbname user=user password=pass

# ================================================================
# Redis 配置（缓存 + WebSocket Channel Layer）
# ================================================================

# 是否启用 Redis（生产环境建议设为 True）
REDIS_ENABLED=False

# Redis 连接信息
REDIS_HOST=localhost          # Docker 部署时设为 redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Redis 连接池配置
REDIS_MAX_CONNECTIONS=100
REDIS_CONNECT_TIMEOUT=5
REDIS_TIMEOUT=10

# ================================================================
# 对象存储（OSS）配置 —— framework.storage
# ================================================================
# backend: local(默认，落 MEDIA_ROOT/oss) | aliyun(阿里云) | s3(MinIO/COS/OBS 等兼容)
# 未启用 / SDK 缺失 / backend=local 时自动降级本地磁盘，业务不中断。

OSS_ENABLED=False
OSS_BACKEND=local
OSS_BUCKET=
# 阿里云=外网/内网域名；s3=endpoint_url（带不带 http(s):// 均可）
OSS_ENDPOINT=
OSS_REGION=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_USE_SSL=True
# 绑定的自定义域名 / CDN，公开对象优先使用
OSS_CUSTOM_DOMAIN=
# 签名 URL 有效期（秒）
OSS_URL_EXPIRE=3600
# 本地后端根目录（相对 BASE_DIR），仅 backend=local 生效
OSS_LOCAL_ROOT=media/oss
# 公开对象访问基础 URL（如 CDN 绝对地址），覆盖默认 media URL
OSS_PUBLIC_BASE_URL=

# 让模型 FileField 默认落到 OSS：设为 framework.storage.django_storage.DjangoOSSStorage
# 默认为本地文件系统（与 Django 原生一致）
DJANGO_DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage

# ================================================================
# Gunicorn 配置（Docker / 生产部署时使用）
# ================================================================

GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_LOG_LEVEL=info

# ================================================================
# Celery 配置（Docker / 生产部署时使用）
# ================================================================

CELERY_WORKERS=4
CELERY_LOG_LEVEL=info

# broker / result backend 优先级：环境变量 > Redis（若启用）> None
# 本地不跑 Celery 可留空；跨服务连 RabbitMQ 示例：amqp://guest:guest@localhost:5672//
# 留空且 REDIS_ENABLED=True 时自动回退到 Redis（db/1）
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ================================================================
# 通知系统配置
# ================================================================

# 通知类型：0=不发送，1=钉钉，2=企业微信，3=邮件，4=飞书（支持多选，逗号分隔）
NOTIFICATION_TYPE=0

# 钉钉机器人
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 飞书机器人
FEISHU_WEBHOOK=
FEISHU_SECRET=

# Lark 机器人
LARK_WEBHOOK=

# 邮件配置
EMAIL_SEND_USER=
EMAIL_HOST=smtp.qq.com
EMAIL_STAMP_KEY=
EMAIL_SEND_LIST=

# 企业微信
WECHAT_WEBHOOK=

# ================================================================
# AI Studio 第三方密钥
# ================================================================
# Google GenAI（Gemini 出图 + Veo 出视频）：providers/google.py 通过
# config/channels.json 的 google_gemini 档案读取 GOOGLE_API_KEY 环境变量。
# 留空时 image/video 任务直接 FAILED + 自动退款（额度生命周期不受影响）。
# 真实出图前请填入你的 Google AI Studio Key。
GOOGLE_API_KEY=

# ================================================================
# 生产环境安全配置
# ================================================================

# 是否强制 HTTPS（生产环境建议设为 True）
SECURE_SSL_REDIRECT=False

# ================================================================
# 日志配置
# ================================================================
# 全局日志级别（DEBUG/INFO/WARNING/ERROR）；留空则 DEBUG=True 时为 DEBUG、否则 INFO
LOG_LEVEL=

# ================================================================
# 错误监控（Sentry）
# ================================================================
# 留空则不上报；生产环境填入 DSN 后，settings 会自动 init_sentry()
# 获取地址: https://<org>.sentry.io/settings/<project>/keys/
SENTRY_DSN=

# ================================================================
# Flower 监控（Celery 任务可视化）
# ================================================================
# 启动: celery -A djangoProjectTest flower
FLOWER_PORT=5555
# URL 前缀（Nginx 反代用，如 /flower）
FLOWER_URL_PREFIX=flower
# 基础认证，格式 用户名:密码；留空则不启用（生产建议开启）
FLOWER_BASIC_AUTH=
# 内存中保留的历史任务数
FLOWER_MAX_TASKS=1000
# 页面自动刷新间隔（秒）
FLOWER_REFRESH_TIME=5

# ================================================================
# API 网关限流
# ================================================================
# 全局默认限流档位（次数/周期 s|m|h|d），如 1000/h、60/m、1000/d；
# 优先级：路由级 APILimitRule > PlanFeature > TenantConfig > 此处全局默认。
# 留空回退代码默认值（settings/base.py）。
GATEWAY_THROTTLE_RATE_IP=1000/h
GATEWAY_THROTTLE_RATE_USER=500/h
GATEWAY_THROTTLE_RATE_TENANT=10000/h
GATEWAY_THROTTLE_RATE_ANON=60/m
GATEWAY_THROTTLE_RATE_ENDPOINT=100/h
# Redis 故障时限流策略：False=fail-closed（拒绝 429，默认）；True=fail-open（降级放行）
GATEWAY_THROTTLE_REDIS_FAIL_OPEN=False

# --- 登录限流（IP+用户名双维度防暴力破解，对齐 Fast-Vben-Admin）---
# 窗口内失败次数达到 MAX_ATTEMPTS 即锁定该 IP/用户名 BLOCK_SECONDS 秒；成功后自动清零。
# 留空回退代码默认（5 次 / 300 秒窗口 / 锁定 900 秒）。Redis 故障时放行不锁。
LOGIN_RATE_LIMIT_ENABLED=True
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900

# --- 注册限流（IP 维度防批量刷注册）---
# 窗口内注册请求次数（成功/失败均计）达到 MAX_ATTEMPTS 即锁定该 IP BLOCK_SECONDS 秒；
# 注意：注册成功【不】清零（否则批量开号脚本每成功一次即清零、永远到不了阈值），
# 锁随窗口过期自然解除，仅手动解除接口可提前清除。留空回退代码默认（10 次 / 3600 秒窗口 / 锁定 3600 秒）。
REGISTER_RATE_LIMIT_ENABLED=True
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
REGISTER_RATE_LIMIT_BLOCK_SECONDS=3600

# --- 密码重置限流（IP + email 双维度，防邮件轰炸 / 防枚举）---
# 窗口内重置请求（成功/失败/用户不存在均计）达 MAX_ATTEMPTS 即锁定该 IP / 该 email BLOCK_SECONDS 秒；
# 成功【不】清零（防批量探测轰炸）；Redis 故障 fail-open 放行。留空回退代码默认（5 次 / 3600 秒窗口 / 锁定 3600 秒）。
PASSWORD_RESET_RATE_LIMIT_ENABLED=True
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_RATE_LIMIT_BLOCK_SECONDS=3600
# 找回密码邮件中的前端重置页地址（如 https://app.example.com/reset-password），留空则邮件只含 token 与使用说明
PASSWORD_RESET_FRONTEND_URL=
# 重置 token 有效期（秒，默认 1800=30 分钟），透传 Django PASSWORD_RESET_TIMEOUT
PASSWORD_RESET_TIMEOUT_SECONDS=1800

# --- OAuth2 第三方登录（Authorization Code + PKCE，对齐 Fast-Vben 能力清单）---
# 回调成功后重定向的前端地址（如 https://app.example.com/oauth-callback），
# 留空则回调端点直接返回 JSON（access/refresh），由前端回调页 fetch 处理。
OAUTH2_FRONTEND_REDIRECT_URL=
# state 有效期（秒，默认 600=10 分钟）：授权链接生成到回调消费的窗口，过期作废。
OAUTH2_STATE_TTL=600
# email 命中既有本地用户时自动绑定（默认 True）；未匹配任何用户时自动建号（默认 True，对齐 OIDC）。
# 关闭 AUTO_BIND_EMAIL 后仅允许自动建号或已显式绑定的账号登录。
OAUTH2_AUTO_BIND_EMAIL=True
OAUTH2_AUTO_CREATE_USER=True

# --- MFA TOTP（双因子认证，对齐 Fast-Vben-Admin）---
# ISSUER 显示在 Authenticator App 的颁发者名称；VALID_WINDOW 时钟偏移容忍窗口（默认 1）。
# 留空回退代码默认。SECRET_KEY 轮换会使已加密的 TOTP 密钥无法解密，需用户重新绑定。
MFA_TOTP_ISSUER=Django Enterprise Platform
MFA_TOTP_VALID_WINDOW=1

# --- 日志保留 TTL（manage.py cleanup_logs 消费）---
# 审计/登录/操作日志归档清理保留期（天）；created_at 早于 now-TTL 的记录会被删除，
# AuditLog 删除后自动重置链根保持哈希链自洽。
AUDIT_LOG_TTL_DAYS=180
LOGIN_LOG_TTL_DAYS=90
OPERATION_LOG_TTL_DAYS=90
