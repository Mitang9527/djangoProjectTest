# ================================================================
# 测试 / CI 环境变量文件
# 用途：运行 pytest 测试套件与 CI 流水线的隔离配置（ENV=TEST）。
# 触发方式：由 pytest 的 Django settings 切换（ENV=TEST）读取，
#           不污染本地 .env / 生产 .env.docker。
# 注意：SECRET_KEY / JWT_SIGNING_KEY 为测试专用固定值，切勿用于生产。
# ================================================================
# 测试环境变量
SECRET_KEY=test-secret-key-not-for-production-use-only-at-least-10-chars
JWT_SIGNING_KEY=test-jwt-signing-key-independent-from-secret-key-at-least-10c
DEBUG=False
ENV=TEST
PROJECT_NAME=DjangoTest
TESTER_NAME=Pytest
ALLOWED_HOSTS=*
API_SECRET_KEY=test-api-secret-key-not-for-production-use-at-least-10-chars
