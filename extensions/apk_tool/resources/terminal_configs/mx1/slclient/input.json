{
  "stdkey": {
    "ptt_down": {
      "key": -1,
      "event": "KEY_DOWN"
    },
    "ptt_up": {
      "key": -1,
      "event": "KEY_UP"
    },
    "sos": {
      "key": -2,
      "event": "KEY_LONG_PRESS",
      "time": 3000
    },
    "-3_KEY_DOWN": {
      "event": "KEY_DOWN",
      "key": -3
    },
    "-4_KEY_DOWN": {
      "event": "KEY_DOWN",
      "key": -4
    },
    "enter_group_list": {
      "event": "KEY_DOWN",
      "key": -5
    },
    "enter_member_list": {
      "event": "KEY_DOWN",
      "key": -6
    },
    "-7_KEY_DOWN": {
      "event": "KEY_DOWN",
      "key": -7
    }
  },
  "intent": {
    "ptt_down": {
      "action": "com.lynknex.intent.action.PTT_START"
    },
    "ptt_up": {
      "action": "com.lynknex.intent.action.PTT_STOP"
    },
    "sos": {
      "action": "com.lynknex.intent.action.EMERGENCY_START"
    },
    "-3_KEY_DOWN": {
      "action": "com.lynknex.intent.action.GROUP_SELECT_NEXT"
    },
    "-4_KEY_DOWN": {
      "action": "com.lynknex.intent.action.GROUP_SELECT_PREVIOUS"
    },
    "enter_group_list": {
      "action": "com.lynknex.intent.action.P2.down"
    },
    "enter_member_list": {
      "action": "com.lynknex.intent.action.P3.down"
    },
    "-7_KEY_DOWN": {
      "action": "com.lynknex.intent.action.P4.down"
    }
  },
  "custom": [
    "new_call_in",
    "join_next_group",
    "join_prev_group",
    "ui_map"
  ],
  "action": {
    "ptt_down": {
      "default": [
        {
          "command": {
            "id": "START_SPEAK"
          }
        }
      ],
      "member": [
      ],
      "new_call_in": [
        {
          "command": {
            "id": "ACCEPT_LAST_CALL_INVITE"
          }
        },
        {
          "command": {
            "id": "LEAVE_CUSTOM_STATUS",
            "name": "new_call_in"
          }
        }
      ]
    },
    "ptt_up": {
      "default": [
        {
          "command": {
            "id": "STOP_SPEAK"
          }
        }
      ],
      "member": [
      ],
      "new_call_in": [
      ]
    },
    "-3_KEY_DOWN": {
      "normal": [
        {
          "command": {
            "name": "join_next_group",
            "id": "ENTER_CUSTOM_STATUS",
            "timeout": 30000
          }
        }
      ]
    },
    "-4_KEY_DOWN": {
      "normal": [
        {
          "command": {
            "name": "join_prev_group",
            "id": "ENTER_CUSTOM_STATUS",
            "timeout": 30000
          }
        }
      ]
    },
    "-7_KEY_DOWN":{
      "normal":[
        {
          "command":{
            "name":"ui_map",
            "id":"ENTER_CUSTOM_STATUS",
            "timeout":1000
          }
        }
      ]
    }
  }
}