{
	"stdkey": {
		"-3_KEY_DOWN": {
			"event": "KEY_DOWN",
			"key": -3
		},
		"-3_KEY_UP": {
			"event": "KEY_UP",
			"key": -3
		},
		"ptt_down": {
			"event": "KEY_DOWN",
			"key": -1
		},
		"-2_KEY_UP": {
			"event": "KEY_UP",
			"key": -2
		},
		"sos": {
			"time": 3000,
			"event": "KEY_LONG_PRESS",
			"key": -3
		},
		"-2_KEY_LONG_PRESS": {
			"time": 3000,
			"event": "KEY_LONG_PRESS",
			"key": -2
		},
		"-4_KEY_DOWN": {
			"event": "KEY_DOWN",
			"key": -4
		},
		"-5_KEY_DOWN": {
			"event": "KEY_DOWN",
			"key": -5
		},
		"-2_KEY_DOWN": {
			"event": "KEY_DOWN",
			"key": -2
		},
		"-3_KEY_CLICK": {
			"time": 500,
			"event": "KEY_CLICK",
			"key": -3
		},
		"ptt_up": {
			"event": "KEY_UP",
			"key": -1
		}
	},
	"custom": [
		"record_playback",
		"join_prev_group",
		"switch_group_click",
		"join_next_group"
	],
	"action": {
		"ptt_down": {
			"default": [{
				"command": {
					"id": "START_SPEAK"
				}
			}],
			"member": [{
				"command": {
					"id": "CALL_FOCUS_MEMBER"
				}
			}]
		},
		"-2_KEY_LONG_PRESS": {
			"default": [{
					"filter": {
						"default": false,
						"field": "valueint",
						"method": "equal",
						"type": "command",
						"value": 2,
						"command": {
							"id": "GET_CURRENT_GROUP_TYPE"
						},
						"breaking": true
					},
					"command": {
						"id": "LEAVE_GROUP"
					}
				},
				{
					"command": {
						"id": "ENTER_MEMBER_ITERATOR",
						"timeout": 1000
					}
				}
			]
		},
		"-4_KEY_DOWN": {
			"normal": [{
				"command": {
					"name": "join_next_group",
					"id": "ENTER_CUSTOM_STATUS",
					"timeout": 1000
				}
			}],
			"member": [{
				"command": {
					"id": "FOCUS_NEXT"
				}
			}]
		},
		"-5_KEY_DOWN": {
			"normal": [{
				"command": {
					"name": "join_prev_group",
					"id": "ENTER_CUSTOM_STATUS",
					"timeout": 1000
				}
			}],
			"member": [{
				"command": {
					"id": "FOCUS_PREV"
				}
			}]
		},
		"-3_KEY_CLICK": {
			"normal": [{
				"command": {
					"id": "PLAY_TTS",
					"priority": 4,
					"content": "$current_group_temp$%group_name%, %tts_battery%"
				}
			}]
		},
		"ptt_up": {
			"default": [{
				"command": {
					"id": "STOP_SPEAK"
				}
			}]
		}
	},
	"intent": {
		"-3_KEY_DOWN": {
			"as_key": true,
			"action": "com.android.extKey.one.down"
		},
		"-3_KEY_UP": {
			"as_key": true,
			"action": "com.android.extKey.one.up"
		},
		"ptt_down": {
			"action": "com.dfl.a9.camdown"
		},
		"-2_KEY_UP": {
			"as_key": true,
			"action": "com.android.extKey.voice.up"
		},
		"-4_KEY_DOWN": {
			"action": "com.shli.pocstar.CHANNEL.DOWN"
		},
		"-5_KEY_DOWN": {
			"action": "com.shli.pocstar.CHANNEL.UP"
		},
		"-2_KEY_DOWN": {
			"as_key": true,
			"action": "com.android.extKey.voice.down"
		},
		"ptt_up": {
			"action": "com.dfl.a9.camup"
		}
	}
}