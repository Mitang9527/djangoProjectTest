{
  "stdkey": {
    "ptt_down": {
      "event": "KEY_DOWN",
      "key": -1
    },
    "ptt_up": {
      "event": "KEY_UP",
      "key": -1
    },
    "-2_KEY_DOWN": {
      "event": "KEY_DOWN",
      "key": -2
    },
    "-3_KEY_DOWN": {
      "event": "KEY_DOWN",
      "key": -3
    },
    "sos": {
      "time": 3000,
      "event": "KEY_LONG_PRESS",
      "key": -4
    },
    "-5_KEY_DOWN":{
      "event":"KEY_DOWN",
      "key":-5
    },
    "-6_KEY_DOWN":{
      "event":"KEY_DOWN",
      "key":-6
    }
  },
  "custom": [
    "join_next_group",
    "join_prev_group"
  ],
  "action": {
    "ptt_down": {
      "default": [
        {
          "command": {
            "id": "START_SPEAK"
          }
        }
      ]
    },

    "ptt_up": {
      "default": [
        {
          "command": {
            "id": "STOP_SPEAK"
          }
        }
      ]
    },
    "-2_KEY_DOWN": {
      "normal": [
        {
          "command": {
            "name": "join_next_group",
            "id": "ENTER_CUSTOM_STATUS",
            "timeout": 1000
          }
        }
      ]
    },
    "-3_KEY_DOWN": {
      "normal": [
        {
          "command": {
            "name": "join_prev_group",
            "id": "ENTER_CUSTOM_STATUS",
            "timeout": 1000
          }
        }
      ]
    },
    "-5_KEY_DOWN": {
      "normal": [
        {
          "command": {
            "name": "join_next_group",
            "id": "ENTER_CUSTOM_STATUS",
            "timeout": 1000
          }
        }
      ]
    },
    "-6_KEY_DOWN": {
      "normal": [
        {
          "command": {
            "name": "join_prev_group",
            "id": "ENTER_CUSTOM_STATUS",
            "timeout": 1000
          }
        }
      ]
    }
  },
  "intent": {
    "ptt_down": {
      "action": "android.intent.action.PTT.down"
    },
    "ptt_up": {
      "action": "android.intent.action.PTT.up"
    },
    "-2_KEY_DOWN": {
      "action": "android.intent.action.CHANNELDOWN.down"
    },
    "-3_KEY_DOWN": {
      "action": "android.intent.action.CHANNELUP.up"
    },
    "sos": {
      "action": "android.intent.action.SOS"
    },
    "-5_KEY_DOWN":{
      "action":"android.intent.action.ACTION_ROTATE_LEFT"
    },
    "-6_KEY_DOWN":{
      "action":"android.intent.action.ACTION_ROTATE_RIGHT"
    }
  }
}