{
  "stdkey":{
    "-3_KEY_DOWN":{
      "event":"KEY_DOWN",
      "key":-3
    },
    "ptt_down":{
      "event":"KEY_DOWN",
      "key":-1
    },
    "-5_KEY_LONG_PRESS":{
      "time":3000,
      "event":"KEY_LONG_PRESS",
      "key":-5
    },
    "sos":{
      "time":3000,
      "event":"KEY_LONG_PRESS",
      "key":-2
    },
    "-4_KEY_DOWN":{
      "event":"KEY_DOWN",
      "key":-4
    },
    "ptt_up":{
      "event":"KEY_UP",
      "key":-1
    },
    "-5_KEY_CLICK":{
      "time":500,
      "event":"KEY_CLICK",
      "key":-5
    }
  },
  "custom":[
    "join_next_group",
    "switch_group_name_tts",
    "switch_group_click",
    "join_prev_group"
  ],
  "action":{
    "-3_KEY_DOWN":{
      "normal":[
        {
          "command":{
            "name":"join_next_group",
            "id":"ENTER_CUSTOM_STATUS",
            "timeout":1000
          }
        }
      ],
      "member":[
        {
          "command":{
            "id":"FOCUS_NEXT"
          }
        }
      ]
    },
    "ptt_down":{
      "default":[
        {
          "command":{
            "id":"START_SPEAK"
          }
        }
      ],
      "member":[
      ]
    },
    "-5_KEY_LONG_PRESS":{
      "default":[
        {
          "filter":{
            "default":false,
            "field":"valueint",
            "method":"equal",
            "type":"command",
            "value":2,
            "command":{
              "id":"GET_CURRENT_GROUP_TYPE"
            },
            "breaking":true
          },
          "command":{
            "id":"LEAVE_GROUP"
          }
        },
        {
          "command":{
            "id":"ENTER_MEMBER_ITERATOR",
            "timeout":1000
          }
        }
      ]
    },
    "-4_KEY_DOWN":{
      "normal":[
        {
          "command":{
            "name":"join_prev_group",
            "id":"ENTER_CUSTOM_STATUS",
            "timeout":1000
          }
        }
      ],
      "member":[
        {
          "command":{
            "id":"FOCUS_PREV"
          }
        }
      ]
    },
    "ptt_up":{
      "default":[
        {
          "command":{
            "id":"STOP_SPEAK"
          }
        }
      ]
    },
    "-5_KEY_CLICK":{
      "normal":[
        {
          "filter":{
            "default":true,
            "method":"equal",
            "field":"valueint",
            "type":"command",
            "value":2,
            "command":{
              "id":"GET_CURRENT_GROUP_TYPE"
            },
            "breaking":true
          },
          "command":{
            "id":"LEAVE_GROUP"
          }
        }
      ]
    }
  },
  "intent":{
    "-3_KEY_DOWN":{
      "action":"android.intent.action.CHANNELDOWN"
    },
    "ptt_down":{
      "action":"android.intent.action.PTT.down"
    },
    "-5_KEY_LONG_PRESS":{
      "action":"android.intent.action.FUN.longpress"
    },
    "sos":{
      "action":"android.intent.action.SOS.longpress"
    },
    "-4_KEY_DOWN":{
      "action":"android.intent.action.CHANNELUP"
    },
    "ptt_up":{
      "action":"android.intent.action.PTT.up"
    },
    "-5_KEY_CLICK":{
      "action":"android.intent.action.FUN.down"
    }
  }
}