{
  "stdkey":{
    "-3_KEY_DOWN":{
      "event":"KEY_DOWN",
      "key":-3
    },
    "-3_KEY_UP":{
      "event":"KEY_UP",
      "key":-3
    },
    "ptt_down":{
      "event":"KEY_DOWN",
      "key":-1
    },
    "ptt_up":{
      "event":"KEY_UP",
      "key":-1
    },
    "-4_KEY_DOWN":{
      "event":"KEY_DOWN",
      "key":-4
    },
    "-4_KEY_UP":{
      "event":"KEY_UP",
      "key":-4
    },
    "-2_KEY_DOWN":{
      "event":"KEY_DOWN",
      "key":-2
    },
    "-2_KEY_UP":{
      "event":"KEY_UP",
      "key":-2
    },
    "sos":{
      "time":3000,
      "event":"KEY_LONG_PRESS",
      "key":-2
    }
  },
  "custom":[
    "join_next_group",
    "switch_group_name_tts",
    "switch_group_click",
    "join_prev_group",
    "system_setting"
  ],
  "action":{
    "-4_KEY_DOWN":{
      "normal":[
        {
          "command":{
            "name":"join_next_group",
            "id":"ENTER_CUSTOM_STATUS",
            "timeout":100
          }
        }
      ]
    },
    "ptt_down":{
      "normal":[
        {
          "command":{
            "id":"START_SPEAK"
          }
        }
      ],
      "group":[
        {
          "command":{
            "id":"START_SPEAK"
          }
        }
      ]
    },
    "-3_KEY_DOWN":{
      "normal":[
        {
          "command":{
            "name":"join_prev_group",
            "id":"ENTER_CUSTOM_STATUS",
            "timeout":100
          }
        }
      ]
    },
    "ptt_up":{
      "default":[
        {
          "command":{
            "id":"STOP_SPEAK"
          }
        }
      ]
    }
  },
  "intent":{
    "-3_KEY_UP":{
      "action":"android.intent.action.CHANNELUP.up"
    },
    "-3_KEY_DOWN":{
      "action":"android.intent.action.CHANNELUP.down"
    },
    "-4_KEY_DOWN":{
      "action":"android.intent.action.CHANNELDOWN.down"
    },
    "-4_KEY_UP":{
      "action":"android.intent.action.CHANNELDOWN.up"
    },
    "-2_KEY_DOWN":{
      "as_key":true,
      "action":"android.intent.action.SOS.down"
    },
    "-2_KEY_UP":{
      "as_key":true,
      "action":"android.intent.action.SOS.up"
    },
    "ptt_down":{
      "action":"android.intent.action.PTT.down"
    },
    "ptt_up":{
      "action":"android.intent.action.PTT.up"
    }
  }
}