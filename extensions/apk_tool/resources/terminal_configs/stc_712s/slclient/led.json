{
    "control":{
        "red_on":{
            "intent":{
                "action":"com.intent.redled.on"
            }
        },
        "red_off":{
            "intent":{
                "action":"com.intent.redled.off"
            }
        },
        "green_on":{
            "intent":{
                "action":"com.intent.greenled.on"
            }
        },
        "green_off":{
            "intent":{
                "action":"com.intent.greenled.off"
            }
        },
        "blue_on":{
            "intent":{
                "action":"com.intent.blueled.on"
            }
        },
        "blue_off":{
            "intent":{
                "action":"com.intent.blueled.off"
            }
        },
        "red_strobe_on":{
            "intent":{
                "action":"com.intent.red_strobe.on"
            }
        },
        "red_strobe_off":{
            "intent":{
                "action":"com.intent.red_strobe.off"
            }
        },
        "blue_strobe_on":{
            "intent":{
                "action":"com.intent.blue_strobe.on"
            }
        },
        "blue_strobe_off":{
            "intent":{
                "action":"com.intent.blue_strobe.off"
            }
        },
        "green":{
            "intent":{
                "action":"com.android.action.led.open.green"
            }
        },
        "off":{
            "intent":{
                "action":"com.android.action.led.close"
            }
        }
    },
    "theme":{
        "BLUE_LED": ["blue_strobe_on"],
        "READ_LED": ["red_strobe_on"],
        "READ_BLUE_OFF" : ["red_strobe_off","blue_strobe_off"],
        "ON_STANDBY": ["red_off", 0,"green_off",0,"blue_off",0],
        "WHEN_RECEIVING_VOICE":["green_on"],
        "WHEN_SENDING_VOICE":["red_on"],
        "WHEN_DISCONNECTED": ["red_strobe_on",1000,"red_strobe_off",1000]
    },
    "enabled":true
}