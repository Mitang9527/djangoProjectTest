{
    "NOTIFY_CONNECTED": [
        {
            "command": {
                "id": "PLAY_TTS",
                "priority": 4,
                "content": "$login_success$"
            }
        },
        {
            "command": {
                "id": "LED_THEME",
                "name": "ON_STANDBY",
                "valueint": 1
            }
        }
    ],
    "NOTIFY_DISCONNECT" : [
        {
            "tts" : {
                "content" : "%error_msg%"
            }
        }
    ],
    "NOTIFY_FATAL": [
        {
            "command": {
                "id": "PLAY_TTS",
                "priority": 4,
                "content": "%error_msg%"
            }
        }
    ],
    "CAN_NOT_SPEAK" : [
        {
            "filter": {
                "type": "command",
                "field": "valueint8",
                "method": "not equal",
                "value": 0,
                "default": true,
                "breaking": true,
                "command": { "id": "GET_CURRENT_GID"}
            },
            "command" : {
                "id" : "PLAY_TONE" ,
                "priority" : 150 ,
                "method" : "square" ,
                "freq": 470,
                "duration": 100,
                "amplitude": 10
            }
        }
    ] ,
    "LOST_MIC" : [
