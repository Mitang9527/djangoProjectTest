{
  "stdkey": {
    "ptt_down": {
      "event": "KEY_DOWN",
      "key": -1
    },
    "ptt_up": {
      "event": "KEY_UP",
      "key": -1
    },
    "-2_KEY_DOWN": {
      "event": "KEY_DOWN",
      "key": -2
    },
    "-2_KEY_UP": {
      "event": "KEY_UP",
      "key": -2
    },
    "sos": {
      "event": "KEY_LONG_PRESS",
      "key": -2,
      "time": 3000
    },
    "-3_KEY_DOWN": {
      "event": "KEY_DOWN",
      "key": -3
    },
    "-4_KEY_DOWN": {
      "event": "KEY_DOWN",
      "key": -4
    },
    "-5_KEY_DOWN": {
      "event": "KEY_DOWN",
      "key": -5
    },
    "-5_KEY_UP": {
      "event": "KEY_UP",
      "key": -5
    },
    "recorder_capture_image": {
      "event": "KEY_CLICK",
      "key": -5,
      "time": 500
    },
    "recorder_capture_video": {
      "event": "KEY_LONG_PRESS",
      "key": -5,
      "time": 3000
    },
    "recorder_capture_audio": {
      "event": "KEY_DOWN",
      "key": -6
    },
    "enter_group_list": {
      "event": "KEY_DOWN",
      "key": -7
    }
  },
  "custom": [
    "join_next_group",
    "switch_group_name_tts",
    "switch_group_click",
    "join_prev_group",
    "new_call_in"
  ],
  "action": {
    "ptt_down": {
      "default": [
        {
          "command": {
            "id": "START_SPEAK"
          }
        }
      ]
    },
    "ptt_up": {
      "default": [
        {
          "command": {
            "id": "STOP_SPEAK"
          }
        }
      ]
    },
    "-3_KEY_DOWN": {
      "normal": [
        {
          "command": {
            "name": "join_next_group",
            "id": "ENTER_CUSTOM_STATUS",
            "timeout": 30000
          }
        }
      ]
    },
    "-4_KEY_DOWN": {
      "normal": [
        {
          "command": {
            "name": "join_prev_group",
            "id": "ENTER_CUSTOM_STATUS",
            "timeout": 30000
          }
        }
      ]
    }
  },
  "intent": {
    "ptt_down": {
      "action": "android.intent.action.PTT.down"
    },
    "ptt_up": {
      "action": "android.intent.action.PTT.up"
    },
    "-2_KEY_DOWN": {
      "as_key": true,
      "action": "android.intent.action.SOS.down"
    },
    "-2_KEY_UP": {
      "as_key": true,
      "action": "android.intent.action.SOS.up"
    },
    "-3_KEY_DOWN": {
      "action": "com.lynknex.intent.action.GROUP_SELECT_NEXT"
    },
    "-4_KEY_DOWN": {
      "action": "com.lynknex.intent.action.GROUP_SELECT_PREVIOUS"
    },
    "-5_KEY_DOWN": {
      "as_key": true,
      "action": "android.lynknex.action.CAMERA.down"
    },
    "-5_KEY_UP": {
      "as_key": true,
      "action": "android.lynknex.action.CAMERA.up"
    },
    "recorder_capture_audio": {
      "action": "android.lynknex.action.AUDIO.down"
    },
    "enter_group_list": {
      "action": "android.lynknex.action.EVIDENCE.mark"
    }

  }
}