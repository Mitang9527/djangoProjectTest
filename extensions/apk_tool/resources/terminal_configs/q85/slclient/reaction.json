{
  "NOTIFY_CONNECTED": [
    {
      "command": {
        "id": "PLAY_TTS",
        "priority": 4,
        "content": "$login_success_s$"
      }
    }
  ],
  "SESSION_CONNECTED": [
    {
      "command": {
        "id": "LED_THEME",
        "name": "ON_STANDBY",
        "valueint": 1
      }
    }
  ],
  "NOTIFY_FATAL": [
    {
      "command": {
        "id": "PLAY_TTS",
        "priority": 4,
        "content": "%error_msg%"
      }
    }
  ],
  "NOTIFY_DISCONNECT": [
    {
      "command": {
        "id": "LED_THEME",
        "name": "WHEN_DISCONNECTED",
        "valueint": 1000
      }
    },
    {
      "tts": {
        "content": "%error_msg%"
      }
    }
  ],
  "CAN_NOT_SPEAK": [
    {
      "filter": {
        "type": "command",
        "field": "valueint8",
        "method": "not equal",
        "value": 0,
        "default": true,
        "breaking": true,
        "command": {
          "id": "GET_CURRENT_GID"
        }
      },
      "command": {
        "id": "PLAY_TONE",
        "priority": 150,
        "method": "square",
        "freq": 470,
        "duration": 100,
        "amplitude": 10
      }
    }
  ],
  "LOST_MIC": [
    {
      "command": {
        "id": "PLAY_TONE",
        "priority": 150,
        "method": "square",
        "freq": 470,
        "duration": 100,
        "amplitude": 10
      }
    }
  ],
  "REQMIC_FAIL": [
    {
      "command": {
        "id": "PLAY_TONE",
        "priority": 150,
        "method": "square",
        "freq": 470,
        "duration": 100,
        "amplitude": 10
      }
    }
  ],
  "BEFORE_SPEAK": [
    {
      "command": {
        "id": "PLAY_TONE",
        "priority": 150,
        "method": "sine",
        "freq": 900,
        "duration": 60,
        "amplitude": 10
      }
    }
  ],
  "START_SPEAK": [
    {
      "command": {
        "id": "LED_THEME",
        "name": "WHEN_SENDING_VOICE",
        "valueint": 0
      }
    }
  ],
  "STOP_SPEAK": [
    {
      "command": {
        "id": "PLAY_TONE",
        "priority": 150,
        "method": "sine",
        "freq": 900,
        "duration": 60,
        "amplitude": 10
      }
    },
    {
      "command": {
        "id": "LED_THEME",
        "name": "ON_STANDBY",
        "valueint": 1000
      }
    }
  ],
  "BEFORE_MEMBER_SPEAK": [
    {
      "command": {
        "id": "PLAY_TONE",
        "priority": 150,
        "method": "sine",
        "freq": 900,
        "duration": 60,
        "amplitude": 10
      }
    }
  ],
  "MEMBER_START_SPEAK": [
    {
      "command": {
        "id": "LED_THEME",
        "name": "WHEN_RECEIVING_VOICE",
        "valueint": 0
      }
    }
  ],
  "MEMBER_STOP_SPEAK": [
    {
      "command": {
        "id": "PLAY_TONE",
        "priority": 150,
        "method": "sine",
        "freq": 900,
        "duration": 60,
        "amplitude": 10
      }
    },
    {
      "command": {
        "id": "LED_THEME",
        "name": "ON_STANDBY",
        "valueint": 1000
      }
    }
  ],
  "JOIN_GROUP": [
    {
      "command": {
        "id": "PLAY_TTS",
        "priority": 4,
        "content": "$join_group$%group_name%"
      }
    },
    {
      "command": {
        "id": "RESET_NORMAL_STATUS"
      }
    }
  ],
  "JOIN_GROUP_ERROR": [
    {
      "command": {
        "id": "PLAY_TTS",
        "priority": 4,
        "content": "$join_group_fail$"
      }
    }
  ],
  "I_START_SOS": [
    {
      "command": {
        "id": "FORCE_REPORT_LOCATION",
        "timeout": 10000
      }
    }
  ],
  "MY_SOS_CLOSED": [
    {
      "command": {
        "id": "STOP_FORCE_REPORT_LOCATION"
      }
    }
  ],
  "FOCUS_UNDERFLOW": [
    {
      "command": {
        "id": "FOCUS_LAST"
      }
    }
  ],
  "FOCUS_OVERFLOW": [
    {
      "command": {
        "id": "FOCUS_FIRST"
      }
    }
  ],
  "ENTER_MEMBER_ITERATOR": [
    {
      "command": {
        "id": "PLAY_TTS",
        "priority": 4,
        "content": "$member_mode$"
      }
    }
  ],
  "MEMBER_ITERATOR_EMPTY": [
    {
      "command": {
        "id": "PLAY_TTS",
        "priority": 4,
        "content": "$empty_member$"
      }
    }
  ],
  "LEAVE_MEMBER_ITERATOR": [
    {
      "command": {
        "id": "PLAY_TTS",
        "priority": 4,
        "content": "$exit_member_mode$,$group_mode$"
      }
    }
  ],
  "MEMBER_FOCUS": [
    {
      "command": {
        "id": "PLAY_TTS",
        "priority": 4,
        "content": "$current_user_temp$%focus_member_name%"
      }
    }
  ],
  "GROUP_ITERATOR_EMPTY": [
    {
      "command": {
        "id": "PLAY_TTS",
        "priority": 4,
        "content": "$empty_group$"
      }
    }
  ],
  "GROUP_FOCUS": [
    {
      "command": {
        "id": "PLAY_TTS",
        "priority": 4,
        "content": "$current_group_temp$%focus_group_name%"
      }
    }
  ],
  "ENTER_CUSTOM_STATUS": [
    {
      "filter": {
        "type": "event",
        "field": "name",
        "value": "switch_group_name_tts",
        "method": "equal",
        "default": true,
        "breaking": false
      },
      "command": {
        "id": "STOP_TTS",
        "priority": 4
      }
    },
    {
      "filter": {
        "type": "event",
        "field": "name",
        "value": "switch_group_name_tts",
        "method": "equal",
        "default": true,
        "breaking": true
      },
      "command": {
        "id": "PLAY_TTS",
        "priority": 4,
        "content": "%cus_focus_group_name%"
      }
    }
  ]
}