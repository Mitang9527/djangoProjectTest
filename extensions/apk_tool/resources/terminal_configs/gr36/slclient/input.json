{
  "stdkey": {
    "ptt_down": {
      "event": "KEY_DOWN",
      "key": -1
    },
    "sos": {
      "time": 3000,
      "event": "KEY_DOWN",
      "key": -3
    },

    "-4_KEY_DOWN": {
      "event": "KEY_DOWN",
      "key": -4
    },
    "-5_KEY_DOWN": {
      "event": "KEY_DOWN",
      "key": -5
    },
    "ptt_up": {
      "event": "KEY_UP",
      "key": -1
    }
  },
  "custom": [
    "join_prev_group",
    "switch_group_name_tts",
    "join_next_group"
  ],
  "action": {
    "ptt_down": {
      "default": [{
        "command": {
          "id": "START_SPEAK"
        }
      }]
    },
    "-4_KEY_DOWN": {
      "normal": [{
        "command": {
          "name": "join_next_group",
          "id": "ENTER_CUSTOM_STATUS",
          "timeout": 1000
        }
      }]
    },
    "-5_KEY_DOWN": {
      "normal": [{
        "command": {
          "name": "join_prev_group",
          "id": "ENTER_CUSTOM_STATUS",
          "timeout": 1000
        }
      }]
    },
    "ptt_up": {
      "default": [{
        "command": {
          "id": "STOP_SPEAK"
        }
      }]
    }
  },
  "intent": {
    "sos": {
      "action": "android.intent.action.SOS"
    },
    "ptt_down": {
      "action": "android.intent.action.PTT.down"
    },
    "-4_KEY_DOWN": {
      "action": "android.intent.action.select_down_button.press"
    },
    "-5_KEY_DOWN": {
      "action": "android.intent.action.select_up_button.press"
    },
    "ptt_up": {
      "action": "android.intent.action.PTT.up"
    }
  }
}