{
  "stdkey": {
    "ptt_down": {
      "key": -1,
      "event": "KEY_DOWN"
    },
    "ptt_up": {
      "key": -1,
      "event": "KEY_UP"
    },
    "sos": {
      "key": -2,
      "event": "KEY_LONG_PRESS",
      "time": 3000
    }
  },
  "intent": {
    "ptt_down": {
      "action": "android.intent.action.PTT.down"
    },
    "ptt_up": {
      "action": "android.intent.action.PTT.up"
    },
    "sos": {
      "action": "com.caltta.echat.hotkey.sos.long"
    }
  },
  "custom": [
    "new_call_in"
  ],
  "action": {
    "ptt_down": {
      "default": [
        {
          "command": {
            "id": "START_SPEAK"
          }
        }
      ]
    },
    "ptt_up": {
      "default": [
        {
          "command": {
            "id": "STOP_SPEAK"
          }
        }
      ]
    }
  }
}