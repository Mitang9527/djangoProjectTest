{
	"stdkey":{
		"ptt_down":{
			"event":"KEY_DOWN",
			"key":-1
		},
		"sos":{
			"time":3000,
			"event":"KEY_LONG_PRESS",
			"key":-2
		},
		"ptt_up":{
			"event":"KEY_UP",
			"key":-1
		},
		"-3_KEY_DOWN":{
			"event":"KEY_DOWN",
			"key":-3
		},
		"-4_KEY_DOWN":{
			"event":"KEY_DOWN",
			"key":-4
		}
	},
	"custom":[
		"join_next_group",
		"switch_group_name_tts",
		"switch_group_click",
		"join_prev_group"
	],
	"action":{
		"ptt_down":{
			"default":[
				{
					"command":{
						"id":"START_SPEAK"
					}
				}
			]
		},
		"ptt_up":{
			"default":[
				{
					"command":{
						"id":"STOP_SPEAK"
					}
				}
			]
		},
		"-3_KEY_DOWN":{
			"normal":[
				{
					"command":{
						"name":"join_next_group",
						"id":"ENTER_CUSTOM_STATUS",
						"timeout":100
					}
				}
			]
		},
		"-4_KEY_DOWN":{
			"normal":[
				{
					"command":{
						"name":"join_prev_group",
						"id":"ENTER_CUSTOM_STATUS",
						"timeout":100
					}
				}
			]
		}
	},
	"intent":{
		"ptt_down":{
			"action":"android.intent.action.PTT.down"
		},
		"sos":{
			"action":"com.ruggear.intent.action.SOS"
		},
		"ptt_up":{
			"action":"android.intent.action.PTT.up"
		},
		"-3_KEY_DOWN":{
			"action":"com.ruggear.intent.action.PTT.CHANNEL.next"
		},
		"-4_KEY_DOWN":{
			"action":"com.ruggear.intent.action.PTT.CHANNEL.prev"
		}
	}
}