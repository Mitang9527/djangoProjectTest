{
  "stdkey": {
    "ptt_down": {
      "event": "KEY_DOWN",
      "key": -1
    },
    "ptt_up": {
      "event": "KEY_UP",
      "key": -1
    },
    "sos": {
      "key": -2,
      "event": "KEY_LONG_PRESS",
      "time": 3000
    },
    "-2_KEY_UP": {
      "key": -2,
      "event": "KEY_UP"
    },
    "-2_KEY_DOWN": {
      "key": -2,
      "event": "KEY_DOWN"
    },
    "enter_member_list": {
      "key": -6,
      "event": "KEY_DOWN"
    }
  },
  "custom": [
    "new_call_in"
  ],
  "action": {
    "ptt_down": {
      "default": [
        {
          "command": {
            "id": "START_SPEAK"
          }
        }
      ]
    },
    "ptt_up": {
      "default": [
        {
          "command": {
            "id": "STOP_SPEAK"
          }
        }
      ]
    }
  },
  "intent": {
    "ptt_down": {
      "action": "com.android.ptt.key.down"
    },
    "ptt_up": {
      "action": "com.android.ptt.key.up"
    },
    "-2_KEY_UP": {
      "as_key": true,
      "action": "com.runbo.sos.key.up"
    },
    "-2_KEY_DOWN": {
      "as_key": true,
      "action": "com.runbo.sos.key.down"
    },
    "enter_member_list": {
      "action": "com.runbo.et.key.down"
    }
  }
}