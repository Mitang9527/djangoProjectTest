{
    "stdkey": {
        "ptt_down": {
            "event": "KEY_DOWN",
            "key": -1
        },
        "ptt_up": {
            "event": "KEY_UP",
            "key": -1
        },
        "-2_KEY_DOWN": {
            "event": "KEY_DOWN",
            "key": -2
        },
        "-2_KEY_UP": {
            "event": "KEY_UP",
            "key": -2
        },
        "sos": {
            "key": -2,
            "event": "KEY_LONG_PRESS",
            "time": 3000
        },
        "join_prev_group": {
            "event": "KEY_DOWN",
            "key": -3
        },
        "join_next_group": {
            "event": "KEY_DOWN",
            "key": -4
        }
    },

    "action": {
        "ptt_down": {
            "default": [
                {
                    "command": {
                        "id": "START_SPEAK"
                    }
                }
            ]

        },
        "ptt_up": {
            "default": [
                {
                    "command": {
                        "id": "STOP_SPEAK"
                    }
                }
            ]
        }

    },
    "intent": {
        "ptt_down": {
            "action": "android.intent.action.PTT.down"
        },
        "ptt_up": {
            "action": "android.intent.action.PTT.up"
        },
        "-2_KEY_DOWN": {
            "as_key" : true,
            "action": "android.intent.action.SOS"
        },
        "-2_KEY_UP": {
            "as_key" : true,
            "action": "android.intent.action.SOS"
        },
        "join_prev_group": {
            "action": "android.intent.action.select_up_button.press"
        },
        "join_next_group": {
            "action": "android.intent.action.select_down_button.press"
        }
    }
}