{
  "stdkey": {
    "ptt_down": {
      "key": -142,
      "event": "KEY_DOWN"
    },
    "ptt_up": {
      "key": -142,
      "event": "KEY_UP"
    },
    "sos": {
      "key": -2,
      "event": "KEY_LONG_PRESS",
      "time": 3000
    },
    "sos_down": {
      "key": -2,
      "event": "KEY_DOWN"
    },
    "sos_up": {
      "key": -2,
      "event": "KEY_UP"
    },
    "video_pass_back": {
      "key": -3,
      "event": "KEY_DOWN"
    },
    "capture_image_media": {
      "key": -4,
      "event": "KEY_DOWN"
    },
    "next_group": {
      "key": -5,
      "event": "KEY_CLICK",
      "time": 1000
    },
    "prev_group": {
      "key": -6,
      "event": "KEY_CLICK",
      "time": 1000
    }
  },
  "intent": {
    "ptt_down": {
      "action": "android.intent.action.PTT.down"
    },
    "ptt_up": {
      "action": "android.intent.action.PTT.up"
    },
    "sos_up":{
      "as_key":true,
      "action":"com.hebs.action.ACTION_STOP_PTT"
    },
    "sos_down":{
      "as_key":true,
      "action":"com.hebs.action.ACTION_START_PTT"
    },
    "video_pass_back": {
      "action": "com.hebs.action.ACTION_START_VIDEO_RECORD"
    },
    "capture_image_media": {
      "action": "com.hebs.action.ACTION_SHUTTER_NOW"
    },
    "next_group": {
      "action": "com.hebs.intent.action.ACTION_KNOB_NEXT"
    },
    "prev_group": {
      "action": "com.hebs.intent.action.ACTION_KNOB_PREV"
    }
  },
  "custom": [
    "new_call_in","join_next_group", "join_prev_group"
  ],
  "action": {
    "prev_group" : {
      "normal" : [
        {
          "command" : {
            "id" : "ENTER_CUSTOM_STATUS" ,
            "name" : "join_prev_group" ,
            "timeout" : 30000
          }
        }
      ]
    } ,
    "next_group" : {
      "normal" : [
        {
          "command" : {
            "id" : "ENTER_CUSTOM_STATUS" ,
            "name" : "join_next_group" ,
            "timeout" : 30000
          }
        }
      ]
    },
    "ptt_down": {
      "default": [
        {
          "command": {
            "id": "START_SPEAK"
          }
        }
      ],
      "member": [
      ],
      "new_call_in": [
        {
          "command": {
            "id": "ACCEPT_LAST_CALL_INVITE"
          }
        },
        {
          "command": {
            "id": "LEAVE_CUSTOM_STATUS",
            "name": "new_call_in"
          }
        }
      ]
    },
    "ptt_up": {
      "default": [
        {
          "command": {
            "id": "STOP_SPEAK"
          }
        }
      ],
      "member": [
      ],
      "new_call_in": [
      ]
    }
  }
}