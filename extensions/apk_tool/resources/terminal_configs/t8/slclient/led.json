{
	"enabled": true,
	"control": {
		"red": {
			"serial" : {
				"dev": "/sys/class/leds/red/brightness",
				"at" : "255"
			}
		},


		"red_off": {
			"serial" : {
				"dev": "/sys/class/leds/red/brightness",
				"at" : "0"
			}
		},

		"green": {
			"serial" : {
				"dev": "/sys/class/leds/green/brightness",
				"at" : "255"
			}
		},

		"green_off": {
			"serial" : {
				"dev": "/sys/class/leds/green/brightness",
				"at" : "0"
			}
		}

	},
	"theme": {
		"ON_STANDBY": ["red_off","green",3000,"green_off",1000],
		"WHEN_RECEIVING_VOICE": ["red_off","green"],
		"WHEN_SENDING_VOICE": ["green_off","red"],
		"WHEN_DISCONNECTED": ["green_off","red",3000,"red_off",1000],
		"SOS_SEND_SUCCESSFULLY": ["red_off","green",3000],
		"SOS_SEND_FAILED": ["green_off","red",3000]
	}
}