  "intent": {
    "ptt_down": {
      "action": "android.intent.action.PTT.down"
    },
    "ptt_up": {
      "action": "android.intent.action.PTT.up"
    },
    "sos_T8_d": {
      "as_key": true,
      "action": "android.intent.action.SOS.down"
    },
    "sos_T8_u": {
      "as_key": true,
      "action": "android.intent.action.SOS.up"
    },
    "recorder_capture_video": {
      "action": "com.key.broadcast" ,
      "extra" : {
        "keyCode" : 140,
        "down" : true
      }
    },
    "recorder_capture_image": {
      "action": "com.key.broadcast",
      "extra" : {
        "keyCode" : 27,
        "down" : true
      }
    },
    "recorder_capture_audio": {
      "action": "com.key.broadcast",
      "extra" : {
        "keyCode" : 139,
        "down" : true
      }
    }
  },
  "custom": [
    "new_call_in"
  ],
  "action": {
    "ptt_down": {
      "default": [
        {
          "command": {
            "id": "START_SPEAK"
          }
        }
      ],
      "member": [],
      "new_call_in": [
        {
          "command": {
            "id": "ACCEPT_LAST_CALL_INVITE"
          }
        },
        {
          "command": {
            "id": "LEAVE_CUSTOM_STATUS",
            "name": "new_call_in"
          }
        }
      ]
    },
    "ptt_up": {
      "default": [
        {
          "command": {
            "id": "STOP_SPEAK"
          }
        }
      ],
      "member": [],
      "new_call_in": []
    }
  }
