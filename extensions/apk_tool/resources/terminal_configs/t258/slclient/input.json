{
  "stdkey": {
    "ptt_down": {
      "event": "KEY_DOWN",
      "key": -1
    },
    "ptt_up": {
      "event": "KEY_UP",
      "key": -1
    },
    "sos": {
      "key": -2,
      "event": "KEY_LONG_PRESS",
      "time": 3000
    },
    "-3_KEY_DOWN": {
      "key": -3,
      "event": "KEY_DOWN"
    },
    "-4_KEY_DOWN": {
      "key": -4,
      "event": "KEY_DOWN"
    }
  },
  "custom": [
    "join_next_group",
    "join_prev_group"
  ],
  "action": {
    "ptt_down": {
      "default": [
        {
          "command": {
            "id": "START_SPEAK"
          }
        }
      ]
    },
    "ptt_up": {
      "default": [
        {
          "command": {
            "id": "STOP_SPEAK"
          }
        }
      ]
    },
    "-3_KEY_DOWN": {
      "normal": [
        {
          "command": {
            "id": "ENTER_CUSTOM_STATUS",
            "name": "join_prev_group",
            "timeout": 30000
          }
        }
      ]
    },
    "-4_KEY_DOWN": {
      "normal": [
        {
          "command": {
            "name": "join_next_group",
            "id": "ENTER_CUSTOM_STATUS",
            "timeout": 30000
          }
        }
      ]
    }
  },
  "intent": {
    "ptt_down": {
      "action": "android.intent.action.PTT.down"
    },
    "ptt_up": {
      "action": "android.intent.action.PTT.up"
    },
    "sos": {
      "action": "android.intent.action.SOS.longpress"
    },
    "-3_KEY_DOWN": {
      "action": "android.intent.action.CK2.down"
    },
    "-4_KEY_DOWN": {
      "action": "android.intent.action.CK1.down"
    }
  }
}