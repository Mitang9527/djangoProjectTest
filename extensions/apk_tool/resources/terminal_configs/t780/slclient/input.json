{
	"stdkey":{
		"-2_KEY_CLICK":{
			"time":500,
			"event":"KEY_CLICK",
			"key":-2
		},
		"ptt_down":{
			"event":"KEY_DOWN",
			"key":-1
		},
		"-5_KEY_DOWN":{
			"event":"KEY_DOWN",
			"key":-5
		},
		"-5_KEY_UP":{
			"event":"KEY_UP",
			"key":-5
		},
		"-4_KEY_UP":{
			"event":"KEY_UP",
			"key":-4
		},
		"sos":{
			"time":3000,
			"event":"KEY_LONG_PRESS",
			"key":-5
		},
		"-4_KEY_CLICK":{
			"time":500,
			"event":"KEY_CLICK",
			"key":-4 
		},
		"-4_KEY_DOWN":{
			"event":"KEY_DOWN",
			"key":-4
		},
		"-4_KEY_LONG_PRESS":{
			"time":3000,
			"event":"KEY_LONG_PRESS",
			"key":-4
		},
		"-3_KEY_CLICK":{
			"time":500,
			"event":"KEY_CLICK",
			"key":-3
		},
		"ptt_up":{
			"event":"KEY_UP",
			"key":-1
		},
		"-6_KEY_CLICK":{
			"time":500,
			"event":"KEY_CLICK",
			"key":-6
		}
	},
	"custom":[
		"join_next_group",
		"switch_group_name_tts",
		"switch_group_click",
		"join_prev_group"
	],
	"action":{
		"-2_KEY_CLICK":{
			"normal":[
				{
					"command":{
						"name":"join_next_group",
						"id":"ENTER_CUSTOM_STATUS",
						"timeout":1000
					}
				}
			],
			"member":[
				{
					"command":{
						"id":"FOCUS_NEXT"
					}
				}
			]
		},
		"ptt_down":{
			"default":[
				{
					"command":{
						"id":"START_SPEAK"
					}
				}
			],
			"member":[
				{
					"command":{
						"id":"CALL_FOCUS_MEMBER"
					}
				}
			]
		},
		"-4_KEY_CLICK":{
			"normal":[
				{
					"filter":{
						"default":true,
						"method":"equal",
						"field":"valueint",
						"type":"command",
						"value":2,
						"command":{
							"id":"GET_CURRENT_GROUP_TYPE"
						},
						"breaking":true
					},
					"command":{
						"id":"LEAVE_GROUP"
					}
				}
			]
		},
		"-4_KEY_LONG_PRESS":{
			"default":[
				{
					"filter":{
						"default":false,
						"field":"valueint",
						"method":"equal",
						"type":"command",
						"value":2,
						"command":{
							"id":"GET_CURRENT_GROUP_TYPE"
						},
						"breaking":true
					},
					"command":{
						"id":"LEAVE_GROUP"
					}
				},
				{
					"command":{
						"id":"ENTER_MEMBER_ITERATOR",
						"timeout":1000
					}
				}
			]
		},
		"-3_KEY_CLICK":{
			"normal":[
				{
					"command":{
						"name":"join_prev_group",
						"id":"ENTER_CUSTOM_STATUS",
						"timeout":1000
					}
				}
			],
			"member":[
				{
					"command":{
						"id":"FOCUS_PREV"
					}
				}
			]
		},
		"ptt_up":{
			"default":[
				{
					"command":{
						"id":"STOP_SPEAK"
					}
				}
			]
		},
		"-6_KEY_CLICK":{
			"normal":[
				{
					"command":{
						"id":"PLAY_TTS",
						"priority":4,
						"content":"%tts_battery%, $current_group_temp$%group_name%"
					}
				}
			]
		}
	},
		
	"intent":{
		"-2_KEY_CLICK":{
			"action":"android.intent.action.CHANNELUP.down"
		},
		"ptt_down":{
			"action":"android.intent.action.PTT.down"
		},
		"-5_KEY_DOWN":{
			"as_key":true,
			"action":"android.intent.action.SOS.down"
		},
		"-5_KEY_UP":{
			"as_key":true,
			"action":"android.intent.action.SOS.up"
		},
		"-4_KEY_UP":{
			"as_key":true,
			"action":"android.intent.action.FN.up"
		},
		"-4_KEY_DOWN":{
			"as_key":true,
			"action":"android.intent.action.FN.down"
		},
		"-3_KEY_CLICK":{
			"action":"android.intent.action.CHANNELDOWN.down"
		},
		"ptt_up":{
			"action":"android.intent.action.PTT.up"
		},
		"-6_KEY_CLICK":{
			"action":"android.intent.action.POWER.down"
		}
	}
}