{
  "stdkey":{
    "-3_KEY_DOWN":{
      "event":"KEY_DOWN",
      "key":-3
    },
    "-3_KEY_UP":{
      "event":"KEY_UP",
      "key":-3
    },
    "ptt_down":{
      "event":"KEY_DOWN",
      "key":-1
    },
    "-3_KEY_CLICK":{
      "time":500,
      "event":"KEY_CLICK",
      "key":-3
    },
    "-4_KEY_UP":{
      "event":"KEY_UP",
      "key":-4
    },
    "-4_KEY_CLICK":{
      "time":500,
      "event":"KEY_CLICK",
      "key":-4
    },
    "-4_KEY_DOWN":{
      "event":"KEY_DOWN",
      "key":-4
    },
    "enter_group_list":{
      "time":3000,
      "event":"KEY_LONG_PRESS",
      "key":-4
    },
    "sos":{
      "event":"KEY_DOWN",
      "key":-2
    },
    "ptt_up":{
      "event":"KEY_UP",
      "key":-1
    },
    "enter_member_list":{
      "time":3000,
      "event":"KEY_LONG_PRESS",
      "key":-3
    },
    "join_next_group": {
      "key": -5,
      "event": "KEY_DOWN"
    },
    "join_prev_group": {
      "key": -6,
      "event": "KEY_DOWN"
    }
  },
  "custom":[
    "join_next_group",
    "join_prev_group",
    "switch_group_name_tts",
    "switch_group_click"
  ],
  "action":{
    "ptt_down":{
      "default":[
        {
          "command":{
            "id":"START_SPEAK"
          }
        }
      ]
    },
    "-4_KEY_CLICK":{
      "normal":[
        {
          "command":{
            "id":"PLAY_TTS",
            "priority":4,
            "content":"$current_user_temp$%my_name%, $current_group_temp$%group_name%"
          }
        }
      ]
    },
    "-3_KEY_CLICK":{
      "normal":[
        {
          "command":{
            "id":"PLAY_TTS",
            "priority":4,
            "content":"%tts_battery%"
          }
        }
      ]
    },
    "ptt_up":{
      "default":[
        {
          "command":{
            "id":"STOP_SPEAK"
          }
        }
      ]
    },
    "join_prev_group":{
      "normal" : [
        {
          "command" : {
            "id" : "ENTER_CUSTOM_STATUS" ,
            "name" : "join_prev_group" ,
            "timeout" : 30000
          }
        }
      ]
    },
    "join_next_group":{
      "normal" : [
        {
          "command" : {
            "id" : "ENTER_CUSTOM_STATUS" ,
            "name" : "join_next_group" ,
            "timeout" : 30000
          }
        }
      ]
    }
  },
  "intent":{
    "-3_KEY_DOWN":{
      "as_key":true,
      "action":"android.intent.action.EXT_P1.down"
    },
    "-3_KEY_UP":{
      "as_key":true,
      "action":"android.intent.action.EXT_P1.up"
    },
    "ptt_down":{
      "action":"android.intent.action.EXT_PTT.down"
    },
    "-4_KEY_UP":{
      "as_key":true,
      "action":"android.intent.action.EXT_P2.up"
    },
    "-4_KEY_DOWN":{
      "as_key":true,
      "action":"android.intent.action.EXT_P2.down"
    },
    "sos":{
      "action":"android.intent.action.EXT_P3.down"
    },
    "ptt_up":{
      "action":"android.intent.action.EXT_PTT.up"
    },
    "join_next_group": {
      "action": "com.shli.pocstar.CHANNEL.DOWN"
    },
    "join_prev_group": {
      "action": "com.shli.pocstar.CHANNEL.UP"
    }
  }
}