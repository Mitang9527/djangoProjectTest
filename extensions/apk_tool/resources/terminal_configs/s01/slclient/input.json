{
	"stdkey":{
		"many_ptt_down":{
			"event":"KEY_DOWN",
			"key":-1
		},
		"enter_member_list":{
			"time":500,
			"event":"KEY_CLICK",
			"key":-3
		},
		"-358_KEY_CLICK":{
			"time":500,
			"event":"KEY_CLICK",
			"key":-358
		},
		"-22_KEY_DOWN":{
			"event":"KEY_DOWN",
			"key":-22
		},
		"-22_KEY_UP":{
			"event":"KEY_UP",
			"key":-22
		},
		"sos":{
			"time":3000,
			"event":"KEY_LONG_PRESS",
			"key":-22
		},
		"sos_short": {
			"key": -22,
			"event": "KEY_CLICK",
			"time": 3000
		},
		"enter_group_list":{
			"time":500,
			"event":"KEY_CLICK",
			"key":-2
		},
		"ptt_up":{
			"event":"KEY_UP",
			"key":-1
		},
		"-361_KEY_CLICK":{
			"time":500,
			"event":"KEY_CLICK",
			"key":-361
		}
	},
	"custom":[
		"system_setting",
		"join_prev_group",
		"switch_group_name_tts",
		"switch_group_click",
		"join_next_group"
	],
	"action":{
		"many_ptt_down":{
			"normal":[
				{
					"command":{
						"id":"START_SPEAK"
					}
				}
			],
			"group":[
				{
					"command":{
						"id":"START_SPEAK"
					}
				}
			]
		},
		
		"-358_KEY_CLICK":{
			"normal":[
				{
					"command":{
						"name":"join_prev_group",
						"id":"ENTER_CUSTOM_STATUS",
						"timeout":1000
					}
				}
			]
		},
		"enter_group_list":{
			"default":[
				{
					"command":{
						"id":"PLAY_TTS",
						"priority":4,
						"content":"$current_group_temp$%group_name%"
					}
				}
			]
		},
		"ptt_up":{
			"default":[
				{
					"command":{
						"id":"STOP_SPEAK"
					}
				}
			]
		},
		"-361_KEY_CLICK":{
			"normal":[
				{
					"command":{
						"name":"join_next_group",
						"id":"ENTER_CUSTOM_STATUS",
						"timeout":1000
					}
				}
			]
		}
	},
	"intent":{
		"enter_member_list":{
			"action":"android.intent.action.P1.down"
		},
		"many_ptt_down":{
			"action":"android.intent.action.PTT.down"
		},
		"-358_KEY_CLICK":{
			"action":"android.intent.action.F1.down"
		},
		"enter_group_list":{
			"action":"android.intent.action.P2.down"
		},
		"-22_KEY_UP":{
			"as_key":true,
			"action":"android.intent.action.SOS.up"
		},
		"-22_KEY_DOWN":{
			"as_key":true,
			"action":"android.intent.action.SOS.down"
		},
		"ptt_up":{
			"action":"android.intent.action.PTT.up"
		},
		"-361_KEY_CLICK":{
			"action":"android.intent.action.F2.down"
		}
	}
}