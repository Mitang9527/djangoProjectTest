{
  "stdkey": {
    "ptt_down": {
      "key": -1,
      "event": "KEY_DOWN"
    },
    "ptt_up": {
      "key": -1,
      "event": "KEY_UP"
    },
    "enter_member_list": {
      "key": -2,
      "event": "KEY_DOWN"
    },
    "sos": {
      "event": "KEY_LONG_PRESS",
      "key": -3,
      "time": 3000
    },
    "-4_KEY_DOWN": {
      "key": -4,
      "event": "KEY_DOWN"
    },
    "-5_KEY_DOWN": {
      "key": -5,
      "event": "KEY_DOWN"
    }
  },
  "intent": {
    "ptt_down": {
      "action": "android.intent.action.PTT.down"
    },
    "ptt_up": {
      "action": "android.intent.action.PTT.up"
    },
    "enter_member_list": {
      "action": "android.intent.action.ACTION_FNKEY_DOWN"
    },
    "sos": {
      "action": "android.intent.action.SOS.down"
    },
    "-4_KEY_DOWN": {
      "action": "android.intent.action.CHANNELDOWN"
    },
    "-5_KEY_DOWN": {
      "action": "android.intent.action.CHANNELUP"
    }
  },
  "custom": [
    "join_prev_group",
    "join_next_group",
    "switch_group_name_tts",
    "switch_group_click"
  ],
  "action": {
    "ptt_down": {
      "default": [{
        "command": {
          "id": "START_SPEAK"
        }
      }]
    },
    "ptt_up": {
      "default": [{
        "command": {
          "id": "STOP_SPEAK"
        }
      }]
    },
    "-4_KEY_DOWN": {
      "normal": [{
        "command": {
          "id": "ENTER_CUSTOM_STATUS",
          "name": "join_prev_group",
          "timeout": 500
        }
      }]
    },
    "-5_KEY_DOWN": {
      "normal": [{
        "command": {
          "id": "ENTER_CUSTOM_STATUS",
          "name": "join_next_group",
          "timeout": 500
        }
      }]
    }

  }
}