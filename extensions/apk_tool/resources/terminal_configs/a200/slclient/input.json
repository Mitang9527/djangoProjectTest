{
  "stdkey": {
    "ptt_down": {
      "event": "KEY_DOWN",
      "key": -1
    },
    "ptt_up": {
      "event": "KEY_UP",
      "key": -1
    },
    "-2_KEY_DOWN": {
      "event": "KEY_DOWN",
      "key": -2
    },
    "-2_KEY_UP": {
      "event": "KEY_UP",
      "key": -2
    },
    "sos": {
      "key": -2,
      "event": "KEY_LONG_PRESS",
      "time": 3000
    },
    "-3_select_up": {
      "event": "KEY_DOWN",
      "key": -3
    },
    "-4_select_down": {
      "event": "KEY_DOWN",
      "key": -4
    }
  },
  "custom": [
    "join_next_group",
    "join_prev_group"
  ],
  "action": {
    "ptt_down": {
      "default": [
        {
          "command": {
            "id": "START_SPEAK"
          }
        }
      ]
    },
    "ptt_up": {
      "default": [
        {
          "command": {
            "id": "STOP_SPEAK"
          }
        }
      ]
    },
    "-3_select_up": {
      "normal": [
        {
          "command": {
            "id": "ENTER_CUSTOM_STATUS",
            "name": "join_prev_group",
            "timeout": 30000
          }
        }
      ]
    },
    "-4_select_down": {
      "normal": [
        {
          "command": {
            "id": "ENTER_CUSTOM_STATUS",
            "name": "join_next_group",
            "timeout": 30000
          }
        }
      ]
    }
  },
  "intent": {
    "ptt_down": {
      "action": "android.intent.action.PTT.down"
    },
    "ptt_up": {
      "action": "android.intent.action.PTT.up"
    },
    "-2_KEY_DOWN": {
      "as_key": true,
      "action": "android.intent.action.SOS.down"
    },
    "-2_KEY_UP": {
      "as_key": true,
      "action": "android.intent.action.SOS.up"
    },
    "-3_select_up": {
      "action": "android.intent.action.select_up_button.press"
    },
    "-4_select_down": {
      "action": "android.intent.action.select_down_button.press"
    }
  }
}