{
  "stdkey":{
    "-2_KEY_DOWN":{
      "event":"KEY_DOWN",
      "key":-2
    },
    "-2_KEY_UP":{
      "event":"KEY_UP",
      "key":-2
    },
    "enter_group_list":{
      "time":500,
      "event":"KEY_CLICK",
      "key":-2
    },
    "ptt_down":{
      "event":"KEY_DOWN",
      "key":-1
    },
    "sos":{
      "time":3000,
      "event":"KEY_LONG_PRESS",
      "key":-2
    },
    "-4_KEY_CLICK":{
      "time":500,
      "event":"KEY_CLICK",
      "key":-4
    },
    "-3_KEY_DOWN":{
      "event":"KEY_DOWN",
      "key":-3
    },
    "-3_KEY_UP":{
      "event":"KEY_UP",
      "key":-3
    },
    "enter_member_list":{
      "time":500,
      "event":"KEY_CLICK",
      "key":-3
    },
    "-3_KEY_LONG_PRESS":{
      "time":3000,
      "event":"KEY_LONG_PRESS",
      "key":-3
    },
    "ptt_up":{
      "event":"KEY_UP",
      "key":-1
    }
  },
  "custom":[
    "record_playback",
    "system_setting"
  ],
  "action":{
    "ptt_down":{
      "default":[
        {
          "command":{
            "id":"START_SPEAK"
          }
        }
      ]
    },
    "enter_group_list":{
      "normal": [{
        "command": {
          "id": "PLAY_TTS",
          "priority": 4,
          "content": "$current_group_temp$%group_name%"
        }
      }]
    },
    "-4_KEY_CLICK":{
      "default":[
        {
          "command":{
            "id":"RESET_NORMAL_STATUS"
          }
        },
        {
          "command":{
            "name":"system_setting",
            "id":"ENTER_CUSTOM_STATUS",
            "timeout":30000
          }
        }
      ]
    },
    "-3_KEY_LONG_PRESS":{
      "normal": [{
        "command": {
          "id": "PLAY_TTS",
          "priority": 4,
          "content": "%tts_battery%"
        }
      }]
    },
    "ptt_up":{
      "default":[
        {
          "command":{
            "id":"STOP_SPEAK"
          }
        }
      ]
    }
  },
  "intent":{
    "-2_KEY_DOWN":{
      "as_key" : true,
      "action":"unipro.hotkey.sos.down"
    },
    "-2_KEY_UP":{
      "as_key" : true,
      "action":"unipro.hotkey.sos.up"
    },
    "ptt_down":{
      "action":"unipro.hotkey.ptt.down"
    },
    "-4_KEY_CLICK":{
      "action":"unipro.hotkey.menu.down"
    },
    "-3_KEY_DOWN":{
      "as_key" : true,
      "action":"unipro.hotkey.vb.down"
    },
    "-3_KEY_UP":{
      "as_key" : true,
      "action":"unipro.hotkey.vb.up"
    },
    "ptt_up":{
      "action":"unipro.hotkey.ptt.up"
    }
  }
}