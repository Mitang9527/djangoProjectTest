{
    "control":{
        "red":{
            "intent":{
                "action":"android.action.led.notify",
                "extra":{
                    "color":"0xffff0000"
                }
            }
        },
        "red_off":{
            "intent":{
                "action":"android.action.led.notify",
                "extra":{
                    "color":"0x00ff0000"
                }
            }
        },
        "green":{
            "intent":{
                "action":"android.action.led.notify",
                "extra":{
                    "color":"0xff00ff00"
                }
            }
        },
        "green_off":{
            "intent":{
                "action":"android.action.led.notify",
                "extra":{
                    "color":"0x0000ff00"
                }
            }
        }
    },
    "enabled":true,
    "theme" : {
        "ON_STANDBY": ["green_off",3000,"green",1000],
        "WHEN_RECEIVING_VOICE": ["green"],
        "WHEN_SENDING_VOICE": ["red"],
        "WHEN_DISCONNECTED": ["red",3000,"red_off",1000],
        "SOS_SEND_SUCCESSFULLY": ["green",3000],
        "SOS_SEND_FAILED": ["red",3000],
        "SOS_RECEIVED": ["red",1000]
    }
}