# ================================================================
# Docker 部署 - 主平台容器环境变量文件（被 docker-compose 的 env_file 引用）
# 用途：为「主平台」(django / celery / asgi 等容器) 提供运行期环境变量。
# 被以下文件引用（env_file: .env.docker）：
#   - docker-compose.yml
#   - docker-compose.prod.yml
#   - docker-compose.stack.yml
# 注意：
#   - 此处多为占位值，生产请填真实值，或用 Docker Secrets / Vault 管理密钥。
#   - 全栈共享变量（跨服务 JWT 等）由 .env.stack 通过 --env-file 注入，不在此文件。
# ================================================================

# ==================== Django 核心配置 ====================
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production-min-50-chars!!
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com
TOKEN_EXPIRE_HOURS=1

# ==================== 项目基础信息 ====================
PROJECT_NAME=DjangoSaaS
TESTER_NAME=Admin
ENV=PROD

# ==================== 数据库配置（PostgreSQL）====================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=saas_db
DB_USER=saas_user
DB_PASSWORD=your_db_password_here
DB_HOST=postgres
DB_PORT=5432

# ==================== Redis 配置 ====================
REDIS_ENABLED=True
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here
REDIS_MAX_CONNECTIONS=100
REDIS_CONNECT_TIMEOUT=5
REDIS_TIMEOUT=10

# ==================== Gunicorn 配置 ====================
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_LOG_LEVEL=info

# ==================== Celery 配置 ====================
CELERY_WORKERS=4
CELERY_LOG_LEVEL=info

# ==================== 邮件配置 ====================
EMAIL_SEND_USER=
EMAIL_HOST=smtp.qq.com
EMAIL_STAMP_KEY=
EMAIL_SEND_LIST=

# ==================== 通知配置 ====================
NOTIFICATION_TYPE=0
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
FEISHU_WEBHOOK=
FEISHU_SECRET=
LARK_WEBHOOK=
WECHAT_WEBHOOK=
