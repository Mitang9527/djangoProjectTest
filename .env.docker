# ================================================================
# Docker 环境变量配置文件
# 复制此文件并填写真实值后使用
# 注意：生产环境请用 Docker Secrets 或 Vault 管理密钥
# ================================================================

# ==================== Django 核心配置 ====================
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production-min-50-chars!!
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com
TOKEN_EXPIRE_HOURS=24

# ==================== 项目基础信息 ====================
PROJECT_NAME=DjangoSaaS
TESTER_NAME=Admin
ENV=PROD

# ==================== 数据库配置（PostgreSQL）====================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=saas_db
DB_USER=saas_user
DB_PASSWORD=your_db_password_here
DB_HOST=postgres
DB_PORT=5432

# ==================== Redis 配置 ====================
REDIS_ENABLED=True
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here
REDIS_MAX_CONNECTIONS=100
REDIS_CONNECT_TIMEOUT=5
REDIS_TIMEOUT=10

# ==================== RabbitMQ（可选，如不用则保持 False）====================
RABBITMQ_ENABLED=False
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ==================== Gunicorn 配置 ====================
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_LOG_LEVEL=info

# ==================== Celery 配置 ====================
CELERY_WORKERS=4
CELERY_LOG_LEVEL=info

# ==================== 邮件配置 ====================
EMAIL_SEND_USER=
EMAIL_HOST=smtp.qq.com
EMAIL_STAMP_KEY=
EMAIL_SEND_LIST=

# ==================== 通知配置 ====================
NOTIFICATION_TYPE=0
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
FEISHU_WEBHOOK=
FEISHU_SECRET=
LARK_WEBHOOK=
WECHAT_WEBHOOK=
